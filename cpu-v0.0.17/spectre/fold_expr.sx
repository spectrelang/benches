val SEED_A: i64 = 1234567
val SEED_B: i64 = 7654321
val ROUNDS: i64 = 6000000

fn step(x: i64, y: i64) i64 = {
    val a: i64 = x * 3 + y * 5
    val b: i64 = a % 1000003
    val c: i64 = (b * b) % 1000009
    return c + a % 97
}

pub fn main() i32 = {
    val acc: mut u64 = 0
    for i = 0, i < ROUNDS, i++ {
        acc = (acc * 1099511628211 + step(SEED_A, SEED_B) as u64) ^ (acc >> 7)
    }
    trust @print("{d}\n", {(acc & 0x7fffffff) as i64})
    return 0
}
