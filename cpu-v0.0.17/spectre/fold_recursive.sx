val ROUNDS: i64 = 4000000

fn fib(n: i64) i64 = {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

pub fn main() i32 = {
    val fibv: i64 = fib(24)
    val acc: mut u64 = 0
    for i = 0, i < ROUNDS, i++ {
        acc = (acc * 1099511628211 + fibv as u64) ^ (acc >> 7)
    }
    trust @print("{d}\n", {(acc & 0x7fffffff) as i64})
    return 0
}
