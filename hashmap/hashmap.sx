val allocators  = use("std/allocators")
val collections = use("std/collections")
val stdio       = use("std/stdio")
val time        = use("std/time")

val KEY_COUNT = 50000
val OPERATIONS = 5000000

pub fn main() void = trust {
    val ac: allocators.HeapAllocator = @zeroed
    val map: ref void = collections.LongMap.new[allocators.HeapAllocator](ac, 131072 as usize)

    val start = time.now_ns()
    for i = 0, i < OPERATIONS, i++ {
        collections.LongMap.add[allocators.HeapAllocator](
            ac,
            map,
            (i % KEY_COUNT) as i64,
            1 as i64
        )
    }
    val elapsed = time.now_ns() - start

    val checksum: mut i64 = 0
    for i = 0, i < KEY_COUNT, i++ {
        checksum += collections.LongMap.get_or(map, i as i64, 0 as i64)
    }

    stdio.print("Spectre: {d} ns\n", {elapsed})
    stdio.print("Checksum: {d}\n", {checksum})
    collections.LongMap.free[allocators.HeapAllocator](ac, map)
}
