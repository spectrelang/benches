val stdio = use("std/stdio")
val time  = use("std/time")

extern (C) fn aligned_alloc(alignment: usize, size: usize) ref void = "aligned_alloc"

val N: i64 = 2048
val ITERS: i64 = 100000

/// Core-language vector kernel: repeated 32-bit multiply-add over three
/// cache-resident arrays.  The inner loop is intentionally element-wise so
/// the compiler can lower it to the widest SIMD width available.
pub fn main() void = trust {
    val a: ref void = aligned_alloc(32 as usize, (N * 4) as usize)
    val b: ref void = aligned_alloc(32 as usize, (N * 4) as usize)
    val c: ref void = aligned_alloc(32 as usize, (N * 4) as usize)

    for i = 0, i < N, i++ {
        @store32(@ptradd(a, i * 4), (i % 97 + 1) as i32)
        @store32(@ptradd(b, i * 4), (i % 89 + 3) as i32)
        @store32(@ptradd(c, i * 4), (i % 83 + 5) as i32)
    }

    val start = time.now_ns()

    for it = 0, it < ITERS, it++ {
        for i = 0, i < N, i++ {
            val x: u32 = @load32(@ptradd(a, i * 4)) as u32
            val y: u32 = @load32(@ptradd(b, i * 4)) as u32
            val z: u32 = @load32(@ptradd(c, i * 4)) as u32
            @store32(@ptradd(c, i * 4), z + x * y)
        }
    }

    val elapsed = time.now_ns() - start
    val sum: mut u64 = 0
    for i = 0, i < N, i++ {
        sum += @load32(@ptradd(c, i * 4)) as u64
    }

    stdio.print("Spectre: {d} ns\n", {elapsed})
    stdio.print("Spectre: {d} ns/pass\n", {elapsed / ITERS})
    stdio.print("Checksum: {d}\n", {sum})
}
